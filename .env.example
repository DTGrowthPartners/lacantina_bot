# ============================================================================
# La Cantina Bot — variables de entorno (PLANTILLA)
# ============================================================================
# Copia este archivo a `.env` y rellena los valores marcados con ⬅️ PENDIENTE.
# ⚠️ NUNCA hagas commit del .env real. Está en .gitignore.
# ============================================================================

# ── ENTORNO ─────────────────────────────────────────────────────────────────
BOT_ENV=production         # development | production
TZ=America/Bogota

# ── DATABASE (Postgres) ─────────────────────────────────────────────────────
# La DB es del bot (chats, miembros, pausas, alertas). La DB de MESAS vive
# aparte en cantina-mesas-backend (SQLite) y se consume via API HTTP.
DATABASE_URL=postgresql+asyncpg://cantina_user:CHANGEME@127.0.0.1:5432/cantina_db
DATABASE_URL_SYNC=postgresql://cantina_user:CHANGEME@127.0.0.1:5432/cantina_db

# ── ANTHROPIC (Claude API) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=                          # ⬅️ PENDIENTE
CLAUDE_MODEL_PRINCIPAL=claude-sonnet-4-6
CLAUDE_MODEL_INTENT=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS_OUTPUT=1024
CLAUDE_PROVIDER=direct                      # direct | dario | fallback

# ── OPENAI (Whisper — transcripción de notas de voz) ────────────────────────
OPENAI_API_KEY=                             # ⬅️ PENDIENTE (sk-proj-...) para transcribir audios
WHISPER_MODEL=whisper-1                     # whisper-1 | gpt-4o-mini-transcribe | gpt-4o-transcribe
WHISPER_IDIOMA=es                           # hint de idioma
FEATURE_TRANSCRIBIR_AUDIO=true              # apagar para volver al "pídeme que escribas"

# ── WHAPI (canal WhatsApp de La Cantina) ────────────────────────────────────
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKEN=                                # ⬅️ PENDIENTE (token nuevo canal Cantina)
WHAPI_NUMERO_BOT=+573008641322              # número del bot de La Cantina
WHAPI_WEBHOOK_SECRET=                       # ⬅️ generar: openssl rand -hex 32
WHAPI_WEBHOOK_URL=https://cantina-bot.dtgrowthpartners.com/webhook

# ── CANTINA API (backend de mesas — fuente de verdad) ──────────────────────
# Node + Express + SQLite ya montado. NO se modifica desde el bot.
# La key NO se expone al cliente; va solo en x-api-key.
CANTINA_API_BASE_URL=https://cantina-api.dtgrowthpartners.com
CANTINA_API_KEY=                            # ⬅️ PENDIENTE (x-api-key)

# ── IDENTIDAD del bot ───────────────────────────────────────────────────────
# Política estricta: contacto sin etiqueta y sin atribución → silencio + alerta
# (esto es público — la Cantina recibe randoms vía pauta o búsqueda).
IDENTIDAD_PRINCIPAL_NOMBRE=La Cantina Plus
IDENTIDAD_PRINCIPAL_PERSONA_FILE=cantina-identidad.md
IDENTIDAD_PRINCIPAL_ESTRICTA=false

# ── ADMIN PANEL (/admin) ────────────────────────────────────────────────────
ADMIN_USER=                                 # ⬅️ PENDIENTE
ADMIN_PASSWORD=                             # ⬅️ PENDIENTE
ADMIN_SESSION_SECRET=                       # ⬅️ generar: openssl rand -hex 32

# ── GRUPO EQUIPO (alertas internas) ─────────────────────────────────────────
# Grupo de WhatsApp donde el bot publica alertas al staff (Fabio, Edgardo,
# Mariana, Diana, etc.). Se obtiene desde whapi /groups o desde el admin.
EQUIPO_CANTINA_GROUP_ID=                    # ⬅️ PENDIENTE (formato 1203...@g.us)

# ── FEATURES ────────────────────────────────────────────────────────────────
FEATURE_HUMANIZACION=true                   # delays anti-detección Meta
FEATURE_HUMAN_TAKEOVER=true                 # si un staff responde manual → pausa bot
FEATURE_RESPONDER_24_7=true                 # responde fuera de horario laboral
HUMANIZATION_TYPING_INDICATOR=true

# ── HORARIO operativo del bot ───────────────────────────────────────────────
# (informativo — para humanización; el bot SÍ responde 24/7 si feature_responder_24_7=true)
HORARIO_INICIO_HORA=10
HORARIO_FIN_HORA=23

# ── RATE LIMIT (whapi) ──────────────────────────────────────────────────────
HUMANIZATION_MAX_OUT_PER_HOUR=100
